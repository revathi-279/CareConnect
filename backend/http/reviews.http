@baseUrl = http://localhost:5000

### 1. Login as John (Customer)
# @name loginCustomer
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "john@example.com",
  "password": "password123"
}
### Store Customer Token
@customerToken = {{loginCustomer.response.body.token}}

### 2. Fetch John's Bookings to get the completed Booking ID and Provider ID
# @name getBookings
GET {{baseUrl}}/api/bookings
Authorization: Bearer {{customerToken}}

### Store the IDs
@bookingId = {{getBookings.response.body.data[0]._id}}
@providerUserId = {{getBookings.response.body.data[0].provider._id}}

### 3. Customer submits a Review!
POST {{baseUrl}}/api/reviews
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "bookingId": "{{bookingId}}",
  "rating": 5,
  "comment": "Jane was fantastic! Replaced the washing machine belt quickly and it runs like new."
}

### 4. Attempt to submit a second review for the same booking (Error Test)
# Expected: 400 Bad Request
POST {{baseUrl}}/api/reviews
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "bookingId": "{{bookingId}}",
  "rating": 4,
  "comment": "Actually, I changed my mind."
}

### 5. Fetch all reviews for this specific Provider (Public Route)
GET {{baseUrl}}/api/reviews/{{providerUserId}}

### 6. Check if Jane's ProviderProfile Rating was auto-updated! (Public Route)
# Expected: The "rating" field on Jane's profile should now be 5 instead of 0.
GET {{baseUrl}}/api/providers